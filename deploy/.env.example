# Modelo das variáveis do docker-compose. Copie para deploy/.env e ajuste os valores:
#   cp deploy/.env.example deploy/.env
# O deploy/.env nunca é versionado. Os valores abaixo servem só para o ambiente local.

# MongoDB: usuário root, criado na primeira subida (com o volume vazio)
MONGO_ROOT_USER=financas
MONGO_ROOT_PASSWORD=financas

# RabbitMQ: usuário do AMQP (5672) e do painel de gerenciamento (15672)
RABBITMQ_USER=financas
RABBITMQ_PASSWORD=financas
